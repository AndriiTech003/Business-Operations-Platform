{
  "name": "@bop/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node dist/cli/migrate.js",
    "seed": "node dist/cli/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@ashamrai/expr": "workspace:*",
    "@ashamrai/flags-node": "file:../../vendor/ashamrai-flags-node-0.0.0.tgz",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@bop/contracts": "workspace:*",
    "@bop/workflow-core": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "5.81.5",
    "cron-parser": "^5.10.1",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.0.13",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "playwright": "1.63.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "prisma": "7.10.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
